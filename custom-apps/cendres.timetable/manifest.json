{
  "sdkVersion": "1.0",
  "id": "cendres.timetable",
  "name": "课程表",
  "version": "1.0.9",
  "author": "小克",
  "description": "白底毛玻璃风格的周课表。整周 / 单日时间轴双视图，当前课高亮、节次带上下课时间；支持粘贴文字、PDF、截图 AI 识别导入，长按课程可修改；每门课可记作业待办；可绑定角色，把课表写进 TA 的记忆，聊天里随口说的作业还能自动识别记进课表。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "media.pick",
    "characters.read",
    "memory.write",
    "memory.readShortTerm",
    "memory.readLongTerm",
    "memory.readCore",
    "memory.search",
    "chat.read",
    "chat.read.background",
    "ui.toast"
  ]
}